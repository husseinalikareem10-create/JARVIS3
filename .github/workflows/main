name: Build JARVIS APK

on:
  workflow_dispatch:
  push:
    paths:
      - "*.zip"
      - ".github/workflows/main.yml"

jobs:
  build:
    runs-on: ubuntu-latest
    permissions:
      contents: read

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "21"

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: "9.3.1"

      - name: Unpack JARVIS project
        shell: bash
        run: |
          ZIP_FILE="$(find . -maxdepth 1 -type f -name '*.zip' -print -quit)"
          test -n "$ZIP_FILE"
          mkdir -p source
          unzip -q "$ZIP_FILE" -d source

      - name: Configure Gemini API key
        shell: bash
        working-directory: source
        env:
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
        run: |
          printf 'GEMINI_API_KEY=%s\n' "$GEMINI_API_KEY" > .env

      - name: Create debug keystore
        shell: bash
        working-directory: source
        run: |
          keytool -genkeypair -v \
            -keystore debug.keystore \
            -storepass android \
            -alias androiddebugkey \
            -keypass android \
            -keyalg RSA \
            -keysize 2048 \
            -validity 10000 \
            -dname "CN=Android Debug,O=Android,C=US"

      - name: Install Android SDK 36
        shell: bash
        run: |
          yes | "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" --licenses >/dev/null || true
          "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" "platforms;android-36" "build-tools;36.0.0"

      - name: Make compile SDK CI-compatible
        shell: bash
        working-directory: source
        run: |
          python3 - <<'PY'
          from pathlib import Path
          p = Path("app/build.gradle.kts")
          s = p.read_text()
          old = 'compileSdk { version = release(36) { minorApiLevel = 1 } }'
          if old in s:
              s = s.replace(old, 'compileSdk = 36')
          p.write_text(s)
          PY

      - name: Improve Gemini reliability
        shell: bash
        working-directory: source
        run: |
          python3 - <<'PY'
          from pathlib import Path

          p = Path("app/src/main/java/com/example/network/GeminiClient.kt")
          s = p.read_text()

          s = s.replace(
              'const val MODEL_NAME = "gemini-3.5-flash"',
              'const val MODEL_NAME = "gemini-3.8-flash"'
          )

          old = '''private val okHttpClient = OkHttpClient.Builder()
        .connectTimeout(60, TimeUnit.SECONDS)
        .readTimeout(60, TimeUnit.SECONDS)
        .writeTimeout(60, TimeUnit.SECONDS)
        .build()'''

          new = '''private val okHttpClient = OkHttpClient.Builder()
        .connectTimeout(60, TimeUnit.SECONDS)
        .readTimeout(60, TimeUnit.SECONDS)
        .writeTimeout(60, TimeUnit.SECONDS)
        .retryOnConnectionFailure(true)
        .addInterceptor { chain ->
            var request = chain.request()
            var response = chain.proceed(request)
            var attempt = 0

            while ((response.code == 429 || response.code in 500..504) && attempt < 4) {
                val code = response.code
                response.close()

                val waitMs = when (attempt) {
                    0 -> 800L
                    1 -> 1600L
                    2 -> 3200L
                    else -> 5000L
                }
                Thread.sleep(waitMs)

                if (code == 503 && attempt >= 1) {
                    val fallbackUrl = request.url.toString()
                        .replace("gemini-3.8-flash", "gemini-3.1-flash-lite")
                    request = request.newBuilder().url(fallbackUrl).build()
                }

                attempt++
                response = chain.proceed(request)
            }
            response
        }
        .build()'''

          if old not in s:
              raise SystemExit("Could not find OkHttp block to patch")
          s = s.replace(old, new)

          s = s.replace(
              'return@withContext Result.failure(Exception("Jarvis Link Error: ${response.code}"))',
              '''val friendlyError = when (response.code) {
                    503 -> "Gemini مشغول حالياً، سيدي. حاول مرة أخرى بعد لحظات."
                    429 -> "تم بلوغ حد الطلبات مؤقتاً، سيدي. حاول بعد قليل."
                    else -> "Jarvis Link Error: ${response.code}"
                }
                return@withContext Result.failure(Exception(friendlyError))'''
          )

          p.write_text(s)
          PY

      - name: Build debug APK
        shell: bash
        working-directory: source
        run: gradle :app:assembleDebug --stacktrace --no-daemon

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: JARVIS-debug-apk
          path: source/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
